{
  "name": "agent-fleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/node/desktop/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.json",
    "build:node": "tsc -p tsconfig.node.json",
    "test": "npm run build:node && node --test dist/node/test",
    "scan": "npm run build:node && node dist/node/src/cli.js scan",
    "daemon": "npm run build:node && node dist/node/src/cli.js daemon",
    "dev:ui": "vite",
    "build:ui": "tsc -p tsconfig.json && vite build",
    "build": "npm run build:node && npm run build:ui",
    "desktop": "electron ."
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  }
}
